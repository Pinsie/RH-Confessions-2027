# === Telegram ===
BOT_TOKEN=123456:ABC-your-botfather-token
BOT_USERNAME=RHConfessionsBot            # without @
CHANNEL_ID=-1001234567890                # the public confession channel
DISCUSSION_GROUP_ID=-1009876543210       # the linked discussion group
ADMIN_GROUP_ID=-1005555555555            # private group: you + trusted mods
BLOCK_CHANNEL_ID=-1004444444444          # block announcement channel to auto-read events (0 = off)
JCRC_GROUP_ID=0                          # JCRC group for /feedback routing (0 = use admin group)
REPORT_PING_THRESHOLD=3                  # louder admin alert once a post hits this many reports
REPORT_HIDE_THRESHOLD=20                 # auto-remove a post at this many distinct reports
HEARTBEAT_ENABLED=true                   # daily proof-of-life message to admin group

# === Security ===
# HMAC salt for hashing user IDs. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_SALT=CHANGE_ME_64_HEX_CHARS
# Fernet key for encrypting the anon-chat relay mapping.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=CHANGE_ME_FERNET_KEY

# === AI moderation & digest polish (optional but recommended) ===
# Default: Anthropic (Claude Haiku). Just set ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=sk-ant-...
MODERATION_MODEL=claude-haiku-4-5-20251001

# --- OR any OpenAI-compatible provider (Gemini / Groq / Ollama / etc.) ---
# If LLM_BASE_URL is set, it takes priority over Anthropic.
# Gemini free tier: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#                   LLM_MODEL=gemini-2.0-flash        (key from aistudio.google.com)
# Groq free tier:   LLM_BASE_URL=https://api.groq.com/openai/v1
#                   LLM_MODEL=llama-3.3-70b-versatile (key from console.groq.com)
# Local Ollama:     LLM_BASE_URL=http://localhost:11434/v1
#                   LLM_MODEL=llama3.1:8b             (LLM_API_KEY=anything)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# === Behaviour ===
TIMEZONE=Asia/Singapore
DIGEST_HOUR=8
DIGEST_MINUTE=0
CONFESS_COOLDOWN_SECONDS=30      # RAISE THIS BEFORE REAL LAUNCH (300 = 5 min)
COMMENT_COOLDOWN_SECONDS=10      # RAISE THIS BEFORE REAL LAUNCH (60 recommended)
MAX_CONFESSION_LEN=2000
MAX_STRIKES_BEFORE_BAN=3
ANON_CHAT_ENABLED=true
ANON_CHAT_TTL_DAYS=30            # encrypted author mapping auto-deleted after this
AUTHOR_HASH_TTL_DAYS=4           # confession/comment author hashes blanked after this (0 = keep forever)
DB_PATH=rh_confessions.db
